# Google Apps Script web-app URL for Amaltas Assistant chat logs
# (see scripts/chat-log-apps-script.gs). Copy to .env.local; leave empty to disable logging.
VITE_CHAT_LOG_URL=

# Google Apps Script web-app URL for alumni registration & profile updates
# (see scripts/alumni-apps-script.gs). Leave empty to fall back to email submissions.
VITE_ALUMNI_URL=
